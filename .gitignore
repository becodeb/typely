# Dependencies
node_modules

# Build output
dist
dist-ssr
*.tsbuildinfo

# Local env — NEVER commit real secrets / API keys.
# Only .env.example is allowed in git.
.env
.env.local
.env.*.local

# Editor / OS clutter
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache
.tmp

# Claude/agent scratch
.claude

# Local asset backups (not shipped)
_backups/

# Skin source PNGs — only the optimised .webp siblings are shipped/tracked.
# Regenerate the .webp with sharp/optimize_images.py after dropping new PNGs.
public/assets/edutic-art/skins/*.png

# Local verification scratch (Playwright screenshots, dev scripts)
screenshots/

# Salida del preview de posiciones de nivel (scripts/preview-level-positions.mjs)
.preview-niveles/

# Prompts de fondo armados desde FONDOS.md (scripts/prompt-fondo.mjs)
.prompts-fondos/

# Pliego de contacto de los iconos de Órbita (scripts/preview-orbita-iconos.mjs)
.preview-orbita/

# Bundles del examen del motor de Automatización (scripts/probar-automatizacion.mjs)
.preview-automatizacion/

# Fuentes 3D del modo Automatización: los .glb y .blend pesan decenas de MB
# y git guarda cada versión para siempre. Se renderizan a PNG y ESO se
# versiona; el modelo vive fuera del repo (ver Images/automatizacion/LEEME.md).
Images/**/*.glb
Images/**/*.gltf
Images/**/*.blend
Images/**/*.blend1
Images/**/*.fbx

# Borradores de diseno del canvas (scripts/prompt-fondo.mjs y /design)
.design-isla1/
.design-gestion/
.design-barra/
