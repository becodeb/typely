# =====================================================================
# Variables de entorno de TYPELY.
#
# Este archivo es una PLANTILLA: copialo a `.env` y completá los valores.
# `.env` está en .gitignore y nunca se commitea.
#
# En producción NO se usa este archivo: los valores viven en Coolify
# (Typely → Environment Variables), cifrados. Nunca copies los de
# producción a tu máquina — armá los tuyos contra una base local.
# =====================================================================


# ---------------------------------------------------------------------
# API — obligatorias para que levante
# ---------------------------------------------------------------------

# Postgres. En tu máquina, apuntá a tu propia base.
# En producción es la URL INTERNA del recurso Postgres de Coolify.
DATABASE_URL=postgres://usuario:clave@localhost:5432/typely

# Secreto de firma de los tokens de sesión.
# Generá uno propio:  openssl rand -base64 48
# Si cambia, se caen todas las sesiones activas.
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma. En desarrollo no hace
# falta: el frontend y la API comparten origen a través del proxy de Vite.
# CORS_ORIGIN=https://typely.becode.com.ar,https://www.typely.becode.com.ar

# Origen absoluto del sitio, para armar URLs del lado del servidor.
# PUBLIC_ORIGIN=https://typely.becode.com.ar

# Prepared statements. Dejalo sin definir contra un Postgres directo (van
# activados, y rinden mejor). Ponelo en true SOLO si algún día hay un
# pooler en modo transacción adelante (pgBouncer y similares): sin esto,
# el síntoma es un error confuso de "prepared statement already exists".
# DB_POOLED=true


# ---------------------------------------------------------------------
# Primer superadmin
# ---------------------------------------------------------------------
# La base arranca vacía y no existe ninguna cuenta por defecto. El primer
# superadmin se crea UNA vez, a mano:
#
#   cd api && npm run bootstrap:dev
#
# El email es opcional (sirve para contacto y recuperación). Si no pasás
# contraseña, el script genera una temporal y la imprime una sola vez.
SUPERADMIN_USERNAME=
SUPERADMIN_NAME=
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=


# ---------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------
# OJO: Vite incrusta las VITE_* en el bundle en tiempo de BUILD. Nunca
# pongas un secreto acá — queda a la vista de cualquiera que abra el
# JavaScript de la página.

# Editor de posiciones de nivel (solo desarrollo).
VITE_ENABLE_LAYOUT_EDITOR=true

# Origen de la API. Vacío = `/api`, que es lo correcto detrás del proxy.
# Solo hace falta si corrés la API en otro origen durante el desarrollo.
# VITE_API_URL=
